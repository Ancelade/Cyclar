# Build output. Cargo.lock is versioned for reproducible applications.
**/target/
**/*.rs.bk
/dist/
**/coverage/
**/test-results/
**/benchmark-results/
*.profraw
*.profdata
*.profdata.*
lcov.info
junit.xml

# Local configuration, identities, credentials and server state.
**/.env
**/.env.*
!**/.env.example
**/data/
**/cyclar-data/
**/.preview-data/
**/secrets/
**/var/
**/backups/
**/backup-*/
**/.cyclar-stage-*/
**/server-key
**/*.redb
**/*.redb.*
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
**/*.p12
**/*.pfx
/cyclar-host.json
/host.json
/controller.json
**/.local/state/cyclar/
config.local.toml
*.log

# Editor and operating-system files.
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
